<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_light">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Settings"
            android:textSize="28sp"
            android:textStyle="bold"
            android:textColor="@color/text_dark"
            android:layout_marginBottom="32dp"/>

        <!-- Connection Settings - Serveur Caméra -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="SERVEUR CAMÉRA (WebRTC)"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="@color/text_light"
            android:letterSpacing="0.1"
            android:layout_marginBottom="16dp"/>

        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp"
            xmlns:app="http://schemas.android.com/apk/res-auto"
            app:cardCornerRadius="12dp"
            app:cardElevation="2dp"
            app:cardBackgroundColor="@color/white">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Adresse IP du serveur caméra"
                    android:textColor="@color/text_dark"
                    android:layout_marginBottom="8dp"/>

                <EditText
                    android:id="@+id/etIpAddress"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="e.g. 192.168.1.100"
                    android:inputType="text"
                    android:background="@android:color/transparent"
                    android:padding="12dp"
                    android:layout_marginBottom="12dp"
                    android:backgroundTint="@color/purple_500"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Port caméra (défaut: 8090)"
                    android:textColor="@color/text_dark"
                    android:layout_marginBottom="8dp"/>

                <EditText
                    android:id="@+id/etPort"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="8090"
                    android:inputType="number"
                    android:background="@android:color/transparent"
                    android:padding="12dp"
                    android:backgroundTint="@color/purple_500"/>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Mot de passe système -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="MOT DE PASSE SYSTÈME"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="@color/text_light"
            android:letterSpacing="0.1"
            android:layout_marginBottom="16dp"/>

        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="32dp"
            app:cardCornerRadius="12dp"
            app:cardElevation="2dp"
            app:cardBackgroundColor="@color/white">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <EditText
                    android:id="@+id/etPassword"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Mot de passe système"
                    android:inputType="textPassword"
                    android:background="@android:color/transparent"
                    android:padding="12dp"/>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Security Level Settings -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="SECURITY LEVEL"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="@color/text_light"
            android:letterSpacing="0.1"
            android:layout_marginBottom="16dp"/>

        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="32dp"
            xmlns:app="http://schemas.android.com/apk/res-auto"
            app:cardCornerRadius="12dp"
            app:cardElevation="2dp"
            app:cardBackgroundColor="@color/white">

            <RadioGroup
                android:id="@+id/rgSecurityLevel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="16dp">

                <RadioButton
                    android:id="@+id/rbDisabled"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Désactivé"
                    android:padding="8dp"
                    android:buttonTint="@color/text_light"/>

                <RadioButton
                    android:id="@+id/rbNormal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Normal"
                    android:padding="8dp"
                    android:buttonTint="@color/purple_500"/>

                <RadioButton
                    android:id="@+id/rbContinuous"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Surveillance continue"
                    android:padding="8dp"
                    android:buttonTint="@color/red_danger"/>
            </RadioGroup>
        </androidx.cardview.widget.CardView>

        <!-- Streaming Mode Settings -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="MODE DE STREAMING"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="@color/text_light"
            android:letterSpacing="0.1"
            android:layout_marginBottom="16dp"/>

        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="32dp"
            app:cardCornerRadius="12dp"
            app:cardElevation="2dp"
            app:cardBackgroundColor="@color/white">

            <RadioGroup
                android:id="@+id/rgStreamingMode"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="16dp">

                <RadioButton
                    android:id="@+id/rbModeAuto"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Auto (essaie WebRTC, sinon MJPEG)"
                    android:padding="8dp"
                    android:buttonTint="@color/purple_500"/>

                <RadioButton
                    android:id="@+id/rbModeWebRTC"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="WebRTC (faible latence)"
                    android:padding="8dp"
                    android:buttonTint="@color/purple_500"/>

                <RadioButton
                    android:id="@+id/rbModeMJPEG"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="MJPEG (compatible sans internet)"
                    android:padding="8dp"
                    android:buttonTint="@color/purple_500"/>
            </RadioGroup>
        </androidx.cardview.widget.CardView>

        <Button
            android:id="@+id/btnSaveSettings"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="Save Configuration"
            android:backgroundTint="@color/purple_500"
            android:textAllCaps="false"
            android:textSize="16sp"
            app:cornerRadius="28dp"/>

    </LinearLayout>
</ScrollView>