<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <WebView
        android:id="@+id/wvLiveFeed"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <TextView
        android:id="@+id/tvLiveFeedStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true"
        android:gravity="center"
        android:padding="12dp"
        android:textColor="#FFFFFF"
        android:background="#80000000"
        android:textSize="14sp"
        android:visibility="gone" />
        
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="LIVE FEED"
        android:textColor="#FF0000"
        android:textStyle="bold"
        android:layout_margin="20dp"
        android:background="#80000000"
        android:padding="8dp"/>

    <!-- Directional Controls - Modern D-Pad Style -->
    <FrameLayout
        android:id="@+id/layoutDirectionalControls"
        android:layout_width="160dp"
        android:layout_height="160dp"
        android:layout_alignParentEnd="true"
        android:layout_alignParentBottom="true"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="100dp">

        <!-- Background circle -->
        <View
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/dpad_background"/>

        <!-- Up Button -->
        <ImageButton
            android:id="@+id/btnUp"
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:layout_gravity="top|center_horizontal"
            android:background="@drawable/dpad_button"
            android:src="@drawable/ic_arrow_up"
            android:scaleType="center"
            android:contentDescription="Haut"/>

        <!-- Down Button -->
        <ImageButton
            android:id="@+id/btnDown"
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:layout_gravity="bottom|center_horizontal"
            android:background="@drawable/dpad_button"
            android:src="@drawable/ic_arrow_down"
            android:scaleType="center"
            android:contentDescription="Bas"/>

        <!-- Left Button -->
        <ImageButton
            android:id="@+id/btnLeft"
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:layout_gravity="center_vertical|start"
            android:background="@drawable/dpad_button"
            android:src="@drawable/ic_arrow_left"
            android:scaleType="center"
            android:contentDescription="Gauche"/>

        <!-- Right Button -->
        <ImageButton
            android:id="@+id/btnRight"
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:layout_gravity="center_vertical|end"
            android:background="@drawable/dpad_button"
            android:src="@drawable/ic_arrow_right"
            android:scaleType="center"
            android:contentDescription="Droite"/>

        <!-- Center circle (decorative) -->
        <View
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_gravity="center"
            android:background="@drawable/dpad_center"/>

    </FrameLayout>

    <!-- Alert Overlay (Visible only when alert triggered) -->
    <LinearLayout
        android:id="@+id/layoutAlertActions"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_alignParentBottom="true"
        android:background="#CCFFFFFF"
        android:padding="24dp"
        android:visibility="gone">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="⚠️ ALERT TRIGGERED"
            android:textColor="#D32F2F"
            android:textSize="20sp"
            android:textStyle="bold"
            android:gravity="center"
            android:layout_marginBottom="8dp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Is this a real intrusion?"
            android:gravity="center"
            android:textSize="16sp"
            android:layout_marginBottom="16dp"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:weightSum="2">

            <Button
                android:id="@+id/btnFalseAlarm"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="False Alarm"
                android:backgroundTint="#4CAF50"
                android:layout_marginEnd="8dp"/>

            <Button
                android:id="@+id/btnRealThreat"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="REAL THREAT"
                android:backgroundTint="#D32F2F"
                android:layout_marginStart="8dp"/>
        </LinearLayout>
    </LinearLayout>

</RelativeLayout>